# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FAST2SMS_API_KEY (Optional): For real background SMS dispatch to Indian (+91) mobile numbers
FAST2SMS_API_KEY=""

# NOTIFICATION_WEBHOOK_URL (Optional): For forwarding real-time bookings to Slack, Zapier, Make, or custom backend
NOTIFICATION_WEBHOOK_URL=""

# SUPABASE_URL: URL of your Supabase project (e.g., https://fclidxvhvnntnbyhrmda.supabase.co)
SUPABASE_URL=

# SUPABASE_ANON_KEY: Publishable / anon key for client & server operations
SUPABASE_ANON_KEY=

# SUPABASE_PROJECT_ID: Supabase project ID (e.g., fclidxvhvnntnbyhrmda)
SUPABASE_PROJECT_ID=

# SUPABASE_BOOKINGS_TABLE: Supabase table name for appointments (default: bookings)
SUPABASE_BOOKINGS_TABLE=

